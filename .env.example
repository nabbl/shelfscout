# Docker Compose / Arcane options
SHELFSCOUT_PORT=3000
SHELFSCOUT_BIND_ADDRESS=0.0.0.0
# Leave empty for local builds; use the project Git URL in Arcane.
SHELFSCOUT_BUILD_CONTEXT=
DEMO_MODE=false
DATA_DIR=./data
SHELFSCOUT_DB=./data/shelfscout.sqlite
OWNER_PASSWORD_HASH=
SESSION_SECRET=
BOOKORBIT_URL=http://bookorbit:3000
# Existing BookOrbit bearer JWT; kept server-side. See docs/integrations.md for permissions.
BOOKORBIT_TOKEN=
# Both IDs are required for an explicit Book Dock destination.
BOOKORBIT_LIBRARY_ID=
BOOKORBIT_FOLDER_ID=
# BookOrbit's actual container Book Dock path (read back from its settings API).
BOOKORBIT_DOCK_DIR=/book-dock
SHELFMARK_URL=http://shelfmark:8084
# Existing Shelfmark session cookie, e.g. session=... . No invented API key.
# Leave blank only if Shelfmark is explicitly configured with authentication disabled.
SHELFMARK_COOKIE=
# Shelfmark-side completed folder output (DESTINATION in its settings UI).
SHELFMARK_OUTPUT_DIR=/books
# Native development: local mount of the SAME shared host incoming directory.
# Compose overrides the worker value to /incoming.
SHELFSCOUT_INCOMING_DIR=
# Compose / Arcane: absolute host directory shared by all three services.
# Example: /srv/books/incoming . Separate from /srv/books/library.
SHELFSCOUT_INCOMING_HOST_DIR=
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
# Review sharing is controlled by the saved Settings checkbox (default off).
