# Docker Compose / Arcane options
SHELFSCOUT_PORT=3000
SHELFSCOUT_BIND_ADDRESS=0.0.0.0
# Leave empty for local builds; use the project Git URL in Arcane.
SHELFSCOUT_BUILD_CONTEXT=
DEMO_MODE=false
DATA_DIR=./data
SHELFSCOUT_DB=./data/shelfscout.sqlite
OWNER_PASSWORD_HASH=
SESSION_SECRET=
BOOKORBIT_URL=http://bookorbit:3000
BOOKORBIT_TOKEN=replace-with-a-managed-bearer-jwt
SHELFMARK_URL=http://shelfmark:8084
SHELFMARK_COOKIE=
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
# Review sharing is controlled by the saved Settings checkbox (default off).
