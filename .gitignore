# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
*.tsbuildinfo

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# Private deployment customizations (use deploy/compose.docktail.example.yml)
/compose.override.yml
/compose.override.yaml
/compose.*.local.yml
/compose.*.local.yaml

# vercel
.vercel

/dist/
/.wrangler/
/outputs/
/work/
/data/*.sqlite
/data/*.sqlite-shm
/data/*.sqlite-wal
